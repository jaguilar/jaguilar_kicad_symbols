  )
  (pad "2" thru_hole rect (at -7.5 4.5) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask")
    (net 2 "IN-") (pinfunction "IN-")
  )
  (pad "3" thru_hole rect (at 7.5 -4.5) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask")
    (net 3 "OUT+") (pinfunction "OUT+")
  )
  (pad "4" thru_hole rect (at 7.5 4.5) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask")
    (net 4 "OUT-") (pinfunction "OUT-")
  )
