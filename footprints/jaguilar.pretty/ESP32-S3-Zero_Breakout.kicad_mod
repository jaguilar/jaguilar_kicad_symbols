(footprint "ESP32-S3-Zero_Breakout" (layer "F.Cu")
  (tedit 64000000)
  (descr "Waveshare ESP32-S3-Zero, 18x23.5mm, 9-pin rows, 0.7 inch spacing")
  (tags "ESP32-S3-Zero Waveshare")
  (attr through_hole)
  (fp_text reference "REF**" (at 0 -13) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value "ESP32-S3-Zero" (at 0 13) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_line (start -9 -11.75) (end 9 -11.75) (layer "F.SilkS") (width 0.12))
  (fp_line (start 9 -11.75) (end 9 11.75) (layer "F.SilkS") (width 0.12))
  (fp_line (start 9 11.75) (end -9 11.75) (layer "F.SilkS") (width 0.12))
  (fp_line (start -9 11.75) (end -9 -11.75) (layer "F.SilkS") (width 0.12))
  
  (fp_line (start -10 -12.75) (end 10 -12.75) (layer "F.CrtYd") (width 0.05))
  (fp_line (start 10 -12.75) (end 10 12.75) (layer "F.CrtYd") (width 0.05))
  (fp_line (start 10 12.75) (end -10 12.75) (layer "F.CrtYd") (width 0.05))
  (fp_line (start -10 12.75) (end -10 -12.75) (layer "F.CrtYd") (width 0.05))

  (pad "1" thru_hole rect (at -8.89 -10.16) (size 2 1.6) (drill 1) (layers "*.Cu" "*.Mask") (net 1 "5V") (pinfunction "5V"))
  (pad "2" thru_hole oval (at -8.89 -7.62) (size 2 1.6) (drill 1) (layers "*.Cu" "*.Mask") (net 2 "GND") (pinfunction "GND"))
  (pad "3" thru_hole oval (at -8.89 -5.08) (size 2 1.6) (drill 1) (layers "*.Cu" "*.Mask") (net 3 "3V3") (pinfunction "3V3"))
  (pad "4" thru_hole oval (at -8.89 -2.54) (size 2 1.6) (drill 1) (layers "*.Cu" "*.Mask") (net 4 "IO1") (pinfunction "IO1"))
  (pad "5" thru_hole oval (at -8.89 0) (size 2 1.6) (drill 1) (layers "*.Cu" "*.Mask") (net 5 "IO2") (pinfunction "IO2"))
  (pad "6" thru_hole oval (at -8.89 2.54) (size 2 1.6) (drill 1) (layers "*.Cu" "*.Mask") (net 6 "IO3") (pinfunction "IO3"))
  (pad "7" thru_hole oval (at -8.89 5.08) (size 2 1.6) (drill 1) (layers "*.Cu" "*.Mask") (net 7 "IO4") (pinfunction "IO4"))
  (pad "8" thru_hole oval (at -8.89 7.62) (size 2 1.6) (drill 1) (layers "*.Cu" "*.Mask") (net 8 "IO5") (pinfunction "IO5"))
  (pad "9" thru_hole oval (at -8.89 10.16) (size 2 1.6) (drill 1) (layers "*.Cu" "*.Mask") (net 9 "IO6") (pinfunction "IO6"))
  
  (pad "10" thru_hole oval (at 8.89 10.16) (size 2 1.6) (drill 1) (layers "*.Cu" "*.Mask") (net 10 "IO7") (pinfunction "IO7"))
  (pad "11" thru_hole oval (at 8.89 7.62) (size 2 1.6) (drill 1) (layers "*.Cu" "*.Mask") (net 11 "IO8") (pinfunction "IO8"))
  (pad "12" thru_hole oval (at 8.89 5.08) (size 2 1.6) (drill 1) (layers "*.Cu" "*.Mask") (net 12 "IO9") (pinfunction "IO9"))
  (pad "13" thru_hole oval (at 8.89 2.54) (size 2 1.6) (drill 1) (layers "*.Cu" "*.Mask") (net 13 "IO10") (pinfunction "IO10"))
  (pad "14" thru_hole oval (at 8.89 0) (size 2 1.6) (drill 1) (layers "*.Cu" "*.Mask") (net 14 "IO11") (pinfunction "IO11"))
  (pad "15" thru_hole oval (at 8.89 -2.54) (size 2 1.6) (drill 1) (layers "*.Cu" "*.Mask") (net 15 "IO12") (pinfunction "IO12"))
  (pad "16" thru_hole oval (at 8.89 -5.08) (size 2 1.6) (drill 1) (layers "*.Cu" "*.Mask") (net 16 "IO13") (pinfunction "IO13"))
  (pad "17" thru_hole oval (at 8.89 -7.62) (size 2 1.6) (drill 1) (layers "*.Cu" "*.Mask") (net 17 "IO43") (pinfunction "IO43"))
  (pad "18" thru_hole oval (at 8.89 -10.16) (size 2 1.6) (drill 1) (layers "*.Cu" "*.Mask") (net 18 "IO44") (pinfunction "IO44"))
)
