  (pad "5" thru_hole circle (at -7.62 1.27) (size 1.7 1.7) (drill 1) (layers "*.Cu" "*.Mask") (net 5 "BIN1") (pinfunction "BIN1"))
  (pad "6" thru_hole circle (at -7.62 3.81) (size 1.7 1.7) (drill 1) (layers "*.Cu" "*.Mask") (net 6 "BIN2") (pinfunction "BIN2"))
